= [f[0] for f in fits]\n","stats[\"intercept\"] = [f[1] for f in fits]\n","fmt = {\"mean_x\": \"{:.2f}\", \"var_x\": \"{:.2f}\", \"mean_y\": \"{:.2f}\", \"var_y\": \"{:.3f}\",\n","       \"r\": \"{:.3f}\", \"slope\": \"{:.3f}\", \"intercept\": \"{:.2f}\"}\n","print(stats.to_string(formatters={k: v.format for k, v in fmt.items()}))\n","\n","fig, axs = plt.subplots(2, 2, sharex=True, sharey=True, figsize=(8, 6))\n","xx = np.linspace(3, 20, 2)\n","for ax, (name, g_) in zip(axs.ravel(), ans.groupby(\"dataset\")):\n","    ax.plot(g_.x, g_.y, \"o\", label=f\"dataset {name}\")\n","    ax.plot(xx, 3.00 + 0.500 * xx, \"-\", label=\"y = 3.00 + 0.500 x\")\n","    ax.legend(loc=\"upper left\")\n","for ax in axs[1]: ax.set_xlabel(\"x (arbitrary units)\")\n","for ax in axs[:, 0]: ax.set_ylabel(\"y (arbitrary units)\")\n","fig.tight_layout()\n","plt.show()"],"id":"c58"},{"cell_type":"markdown","metadata":{"id":"c59"},"source":["**Compare.** Put your `prediction` next to the output above. Was it right? If not, say in one sentence which of your assumptions was wrong."],"id":"c59"},{"cell_type":"code","metadata":{"id":"c60"},"execution_count":null,"outputs":[],"source":["# Check A: the picture above. Check B: sensitivity of dataset III to its largest residual\n","d3 = ans[ans.dataset == \"III\"]\n","s3, i3 = np.polyfit(d3.x, d3.y, 1)\n","res3 = d3.y - (i3 + s3 * d3.x)\n","worst = res3.abs().idxmax()\n","s3b, i3b = np.polyfit(d3.x.drop(worst), d3.y.drop(worst), 1)\n","print(f\"III largest residual {res3.abs().max():.2f} at x = {d3.x[worst]}\")\n","print(f\"III without it: fit y = {i3b:.2f} + {s3b:.3f} x\")\n","print(f\"IV: {int((ans[ans.dataset == 'IV'].x == 8).sum())} of 11 points at x = 8\")"],"id":"c60"},{"cell_type":"markdown","metadata":{"id":"c61"},"source":["**Your turn.** In dataset IV, 10 of the 11 points have x = 8. What determines the fitted slope? What would the slope be if the point at x = 19 were removed?\n","\n","*Hint:* a line through points that all share one x has no