_name__, \"-\", x_.message)\n","print(f\"no p0: A = {p_bad[0]:.0f}, tau = {p_bad[1]:.3f} s, sigma = {np.sqrt(np.diag(c_bad)).tolist()}\")\n","print(f\"       model at t = 30 s: {p_bad[0] * np.exp(-30 / p_bad[1]):.1e} counts; data: {int(counts[1])}\")\n","\n","# 2) with a starting guess\n","p, c = curve_fit(model, tt, counts, p0=(counts[0], 200.0))\n","sA, stau = np.sqrt(np.diag(c))\n","print(f\"p0 = (counts[0], 200 s): A = {p[0]:.0f} +/- {sA:.0f}, tau = {p[1]:.1f} +/- {stau:.1f} s\")\n","print(f\"T_half = tau ln2 = {p[1]*np.log(2):.1f} +/- {stau*np.log(2):.1f} s = {p[1]*np.log(2)/60:.2f} min (literature 2.552 min)\")\n","\n","fig, ax = plt.subplots(figsize=(7, 4.5))\n","ax.errorbar(tt, counts, yerr=np.sqrt(counts), fmt=\"o\", capsize=2, label=\"counts (error bars: sqrt(N))\")\n","tf = np.linspace(0, 900, 300)\n","ax.plot(tf, model(tf, *p), \"-\", label=f\"fit with p0: tau = {p[1]:.1f} s\")\n","ax.plot(tf, model(tf, *p_bad), \"--\", label=f\"fit without p0: tau = {p_bad[1]:.3f} s\")\n","ax.set_yscale(\"log\"); ax.set_ylim(1, 3000)\n","ax.set_xlabel(\"time t (s)\"); ax.set_ylabel(\"counts per 30 s interval\")\n","ax.legend()\n","plt.show()"],"id":"c66"},{"cell_type":"markdown","metadata":{"id":"c67"},"source":["**Compare.** Put your `prediction` next to the output above. Was it right? If not, say in one sentence which of your assumptions was wrong."],"id":"c67"},{"cell_type":"code","metadata":{"id":"c68"},"execution_count":null,"outputs":[],"source":["# Check A: straight line through ln(counts)\n","m = counts > 0\n","k1, k0 = np.polyfit(tt[m], np.log(counts[m]), 1)\n","print(f\"line fit of ln N vs t: tau = {-1/k1:.1f} s\")\n","# Check B: eye estimate, counts halve from counts[0] near t = 150 s\n","print(f\"counts[0] = {int(counts[0])}; counts[5] (t = {tt[5]:.0f} s) = {int(counts[5])}\")"],"id":"c68"},{"cell_type":"markdown","metadata":{"id":"c69"},"source":["**Your turn.** A pendulum experiment plots T² against L and fits a straight line with slope 4.0 s²/m. Find g. W